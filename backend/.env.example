# 国家考古遗址公园智能研究平台 - 环境配置

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=heritage
POSTGRES_PASSWORD=heritage123
POSTGRES_DB=heritage_db

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=heritage123
NEO4J_DATABASE=neo4j
# 知识图谱子系统是否写入 Neo4j（false 时使用本地 data/kg/graph.json）
NEO4J_ENABLED=false

# AI配置 (选择一个)
AI_PROVIDER=dashscope

# 通义千问 (推荐，国产便宜)
DASHSCOPE_API_KEY=your_dashscope_api_key

# OpenAI (可选)
# OPENAI_API_KEY=your_openai_api_key

# Claude (可选)
# CLAUDE_API_KEY=your_claude_api_key

# 登录开关 (false=跳过登录, true=启用登录)
AUTH_ENABLED=false

# JWT密钥 (生产环境请修改)
SECRET_KEY=heritage-park-secret-key-change-in-production

# ===== 知识图谱子系统 (文件库 / 文本解析 / 图谱构建) =====
# 数据根目录（默认 backend/data/kg）：state.json、graph.json、uploads/、text_parse/
KG_STORAGE_DIR=./data/kg
# 单个文件上传上限 (MB)
KG_MAX_UPLOAD_MB=200

# 实体/关系抽取：配置后优先调用 LLM 抽取，失败自动回落到领域词典 + 规则
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_API_KEY=your_llm_api_key
# AI_MODEL=qwen-plus

# ===== AI 模型路由（可选：按任务分配不同模型；留空则沿用上面 AI_PROVIDER/LLM_BASE_URL/AI_MODEL）=====
# MODEL_REGISTRY：模型别名 -> {type, base_url, model, api_key 或 api_key_env}
#   type: text（文本）/ vision（视觉）/ multimodal（两者皆可）
# MODEL_ROUTES：任务名（或能力名 text/vision）-> 模型别名
#   任务名：text.chat（报告撰写/要点抽取）、vision.describe（照片语义描述与图注）
# 示例：文本用 DeepSeek，视觉用通义千问-vl
# MODEL_REGISTRY={"deepseek":{"type":"text","base_url":"https://api.deepseek.com","model":"deepseek-chat","api_key_env":"OPENAI_API_KEY"},"qwen-vl":{"type":"vision","base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1","model":"qwen-vl-max","api_key_env":"DASHSCOPE_API_KEY"}}
# MODEL_ROUTES={"text.chat":"deepseek","vision.describe":"qwen-vl"}
# 也可直接在「模型路由」界面配置（存数据库，优先级高于上面的 JSON；Key 加密落库）
# 模型 Key 落库加密密钥（Fernet key 或任意口令；留空则由 SECRET_KEY 派生）
AI_CREDENTIAL_ENCRYPTION_KEY=
# 首次启动是否播种预置模型（火山/移动云/梧桐等，默认停用且不带 Key）
AI_MODEL_SEED_PRESETS=true

# 扫描件 PDF OCR（可选，需额外安装 pymupdf 与 Pillow）
# SCANNED_PDF_ZOOM=2.0
# SCANNED_PDF_MIN_CHARS_PER_PAGE=30
# SCANNED_PDF_TIMEOUT_SECONDS=120

# ===== 语音转写（腾讯云 录音文件识别极速版 / FlashRecognizer）=====
# 密钥获取：https://console.cloud.tencent.com/cam/capi
TENCENT_APP_ID=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# 识别引擎，中文通用 16k
ASR_ENGINE_TYPE=16k_zh
ASR_MAX_UPLOAD_MB=20

# ===== 田野调研（KML 轨迹照片 / 调研事件 / 报告生成）=====
# 轨迹数据根目录（照片、缩略图、GeoJSON、逆地理缓存）
TRACK_STORAGE_DIR=./data/tracks
TRACK_MAX_UPLOAD_MB=50
TRACK_DOWNLOAD_CONCURRENCY=4
TRACK_DOWNLOAD_RETRIES=2
# 单张照片下载上限，以及单条轨迹照片数上限（0=不限制）；仅允许公网 http/https 照片 URL
TRACK_MAX_PHOTO_MB=20
TRACK_MAX_PHOTOS_PER_TRACK=0
# 逆地理编码：bigdatacloud（免 Key，默认）/ nominatim
GEOCODER_PROVIDER=bigdatacloud
GEOCODER_TIMEOUT_SECONDS=15
GEOCODER_INTERVAL_SECONDS=0.3
# 视觉语义描述走 OpenAI 兼容通道（复用 OPENAI_API_KEY + LLM_BASE_URL + AI_MODEL）
VISION_TIMEOUT_SECONDS=60
# 语义描述并发度：数百张照片同时识别，受上游模型速率限制时调低
TRACK_DESCRIBE_CONCURRENCY=400
# 调研报告 docx 输出目录
SURVEY_REPORT_DIR=./data/survey/reports
